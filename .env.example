# SpagKing Environment Variables
# Copy this file to .env and fill in production values.
# The demo works without any of these — all integrations are mock/demo flows.

# Database (only needed for production backend — demo uses in-memory data)
DATABASE_URL="file:./db/custom.db"

# Payment Integrations (demo flows work without these)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Communication APIs (demo campaign cards work without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
WHATSAPP_BUSINESS_TOKEN=

# Maps (demo uses stylized SVG map — production needs Google Maps API key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Authentication (demo uses role-based login without passwords — production needs NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=
